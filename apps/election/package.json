{
  "name": "@lecpunch/election",
  "version": "0.1.12",
  "private": true,
  "main": ".electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:electron": "tsc -p tsconfig.electron.json --watch",
    "dev:renderer": "node ./node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "tsc -p tsconfig.electron.json && tsc -b && node ./node_modules/vite/bin/vite.js build",
    "package:win": "node scripts/package-win.mjs",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit && tsc -b",
    "start": "node ./node_modules/electron/cli.js ."
  },
  "dependencies": {
    "@lecpunch/shared": "workspace:*",
    "easy-live2d": "^0.4.4",
    "lucide-react": "^1.7.0",
    "pixi.js": "^8.18.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.5.4",
    "vite": "^8.0.3"
  },
  "build": {
    "appId": "org.lecpunch.election",
    "productName": "LecPunch Election",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      ".electron/**/*",
      "package.json",
      "node_modules/uiohook-napi/**/*",
      "node_modules/node-gyp-build/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/uiohook-napi/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LecPunch Election"
    }
  }
}
